{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "bash": "check.sh",
        "windows": "powershell -ExecutionPolicy Bypass -File .github\\hooks\\log.ps1",
        "env": {
          "LOG_LEVEL": "WARNING"
        },
        "timeout": 7
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "bash": "check.sh",
        "windows": "powershell -ExecutionPolicy Bypass -File .github\\hooks\\log.ps1",
        "env": {
          "LOG_LEVEL": "WARNING"
        },
        "timeout": 7
      }
    ],
    "Stop": [
      {
